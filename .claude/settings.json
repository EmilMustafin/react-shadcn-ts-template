{
  "extraKnownMarketplaces": {
    "vadimgaidai": {
      "source": {
        "source": "github",
        "repo": "vadimgaidai/claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "feature-workflow@vadimgaidai": true,
    "react-shadcn-ui@vadimgaidai": true,
    "feature-sliced-design@vadimgaidai": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Edit(pnpm-lock.yaml)",
      "Edit(.git/**)",
      "Edit(dist/**)",
      "Edit(node_modules/**)",
      "Read(*.env*)",
      "Edit(*.env*)",
      "Bash(cat *.env*)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint*)",
      "Bash(pnpm stylelint*)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(npx shadcn@latest *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "mcp__shadcn__*",
      "mcp__context7__*",
      "mcp__figma__*"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
